# Solar Plant Designer - environment variables (copy to .env.local)
# All variables are optional. The app works without any keys.

# Preferred primary solar-resource provider: nasa | pvgis | pvwatts
VITE_SOLAR_PROVIDER=nasa

# NREL developer key for PVWatts v8 (https://developer.nrel.gov/signup/).
# NREL's shared DEMO_KEY is used if empty; it is heavily rate-limited.
VITE_NREL_API_KEY=

# Base URL used for PVGIS requests. Default goes through the Vite dev/preview proxy
# (/api/pvgis -> https://re.jrc.ec.europa.eu/api) because PVGIS does not allow browser CORS.
# For a static deployment, point this at your own reverse proxy.
VITE_PVGIS_BASE_URL=/api/pvgis

# Request timeout for external solar-data calls, in milliseconds
VITE_SOLAR_TIMEOUT_MS=20000
